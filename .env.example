PYTHONPATH=.:src

# Log level for every service: DEBUG / INFO / WARNING (WARN) / ERROR / CRITICAL.
# Unset or unrecognized value falls back to WARN. INFO is handy locally; in production it is
# passed by the deploy workflow from the `LOG_LEVEL` repository variable (default WARN).
LOG_LEVEL=INFO

BOT_API_TOKEN=123:foo
BOT_API_TOKEN__PROD=123:foo
MY_TELEGRAM_ID=123
FORUM_BOT_LOGIN=foo
FORUM_BOT_PASSWORD=foo
OSM_IDENTIFIER=foo
YANDEX_API_KEY=foo
API_CLIENTS=[1,2,3]

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_AUTH_METHOD=trust

WEB_APP_URL_TEST=
WEB_APP_URL=
TITLE_RECOGNIZE_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BACKUP_BUCKET_NAME=

VK_API_KEY=
VK_GROUP_ID=0
VK_CONFIRMATION_CODE=

# phpbb database params
MYSQL_HOST=localhost
MYSQL_DB=phpbb
MYSQL_USER=root
MYSQL_PASS=mysecretroot
MAX_BOT_TOKEN=
MAX_BOT_WEBHOOK_SECRET=

# ─── single container (doc/single-container.md) ───────────────────────────────────────────────
# Only `python -m app.main` reads these; the cloud functions ignore them. The *code* defaults
# are the cloud ones (QUEUE_BACKEND=ymq, TITLE_RECOGNIZE_LOCAL=0) so that deploying the cloud
# functions changes nothing; the container opts in to the new mode right here.
# No inline comments below: docker compose env_file keeps the whole line as the value.
QUEUE_BACKEND=pg
WORKER_THREADS=2
WORKER_POLL_INTERVAL_SECS=1
QUEUE_VISIBILITY_TIMEOUT_SECS=900
QUEUE_MAX_ATTEMPTS=5
QUEUE_RETRY_BASE_SECS=30
QUEUE_RETRY_MAX_SECS=900
SCHEDULER_ENABLED=1
SCHEDULER_TIMEZONE=UTC
# Five fields (minute hour day month weekday), not the Quartz six-field form of terraform.
CRON_CHECK_FIRST_POSTS=* * * * *
CRON_ARCHIVE_TO_BIGQUERY=13 11 * * *
CRON_ARCHIVE_NOTIFICATIONS=0 * * * *
HTTP_ENABLED=1
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
ENABLE_TG_BOT=1
ENABLE_VK_BOT=1
ENABLE_MAX_BOT=1
# 1 = recognize titles in this process; 0 = call title_recognize over HTTP (TITLE_RECOGNIZE_URL).
TITLE_RECOGNIZE_LOCAL=1
API_PATH_ACTIVE_SEARCHES=/api/v1/active-searches
API_PATH_USER_INFO=/api/v1/user-info
# Webhook paths are empty by default: the bots poll. Fill one in to serve a webhook instead.
WEBHOOK_PATH_TELEGRAM=
WEBHOOK_PATH_VK=
WEBHOOK_PATH_MAX=
