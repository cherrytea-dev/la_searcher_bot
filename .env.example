PYTHONPATH=.:src

# Log level for every service: DEBUG / INFO / WARNING (WARN) / ERROR / CRITICAL.
# Unset or unrecognized value falls back to WARN. INFO is handy locally; in production it is
# passed by the deploy workflow from the `LOG_LEVEL` repository variable (default WARN).
LOG_LEVEL=INFO

BOT_API_TOKEN=123:foo
BOT_API_TOKEN__PROD=123:foo
MY_TELEGRAM_ID=123
FORUM_BOT_LOGIN=foo
FORUM_BOT_PASSWORD=foo
OSM_IDENTIFIER=foo
YANDEX_API_KEY=foo
API_CLIENTS=[1,2,3]

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_AUTH_METHOD=trust

WEB_APP_URL_TEST=
WEB_APP_URL=
TITLE_RECOGNIZE_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BACKUP_BUCKET_NAME=

VK_API_KEY=
VK_GROUP_ID=0
VK_CONFIRMATION_CODE=

# phpbb database params
MYSQL_HOST=localhost
MYSQL_DB=phpbb
MYSQL_USER=root
MYSQL_PASS=mysecretroot
MAX_BOT_TOKEN=
MAX_BOT_WEBHOOK_SECRET=

# ─── single container (doc/single-container.md) ───────────────────────────────────────────────
# Only `python -m app.main` reads these; the cloud functions ignore them. The *code* default is
# APP_MODE=yc — the cloud functions (YMQ queue, title recognition over HTTP, timer triggers, no
# HTTP server and no pollers of our own) — so that deploying them changes nothing. The container
# switches the whole runtime with that one variable: the queue backend, local title recognition,
# the cron scheduler, the HTTP server and the bot pollers all follow from APP_MODE and are
# deliberately not separate knobs (a half-cloud/half-container mix is not a real state).
# No inline comments below: docker compose env_file keeps the whole line as the value.
APP_MODE=k8s
# Pool defaults already follow APP_MODE (10/10 in the container); override only to tune memory.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
WORKER_THREADS=2
WORKER_POLL_INTERVAL_SECS=1
QUEUE_VISIBILITY_TIMEOUT_SECS=900
QUEUE_MAX_ATTEMPTS=5
QUEUE_RETRY_BASE_SECS=30
QUEUE_RETRY_MAX_SECS=900
SCHEDULER_TIMEZONE=UTC
# Five fields (minute hour day month weekday), not the Quartz six-field form of terraform.
CRON_CHECK_FIRST_POSTS=* * * * *
# Only scheduled with FORUM_LEGACY_DATA_SOURCE=true (legacy folder-tree scanner).
CRON_CHECK_TOPICS_BY_UPD_TIME=*/5 * * * *
CRON_ARCHIVE_TO_BIGQUERY=13 11 * * *
CRON_ARCHIVE_NOTIFICATIONS=0 * * * *
# Archiving to BigQuery uploads to Object Storage; set to false when the bucket is unavailable.
ARCHIVE_TO_BIGQUERY_ENABLED=true
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
API_PATH_ACTIVE_SEARCHES=/api/v1/active-searches
API_PATH_USER_INFO=/api/v1/user-info
# Webhook paths are empty by default: the bots poll. Fill one in to serve a webhook for that bot
# instead of polling it (its poller is skipped).
WEBHOOK_PATH_TELEGRAM=
WEBHOOK_PATH_VK=
WEBHOOK_PATH_MAX=
# Absolute lower bound on a search's start time for notifications (ISO datetime; empty = no
# bound). Set it when the bot runs against a stale database — see doc/runbooks/temp-db-cutover.md.
NOTIFY_SEARCHES_SINCE=

# ─── логи (сервис Логи Selectel через общий OTel-коллектор ядра) ──────────────────────────────
# Приложение пишет логи в stdout и, если задан OTEL_EXPORTER_OTLP_ENDPOINT, шлёт их по OTLP
# в общий OTel Collector ядра инфраструктуры (сеть data), а тот пересылает записи в сервис
# Логи Selectel. Ключи Selectel знает только коллектор — приложению они не нужны.
# Подробнее: README → «Логи (сервис Логи Selectel)».
#
# В ПРОДЕ эти переменные задаются не здесь, а в файле секретов хоста
# /srv/infra/secrets/la_searcher.env (env_file в docker-compose.shared.yml). Его создаёт
# `make db-create APP=la_searcher` в репозитории infra, он же кладёт туда:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
#   OTEL_SERVICE_NAME=la_searcher
# Поэтому вручную их задавать не нужно. Блок ниже — только для локального запуска.
#
# Адрес OTLP-приёмника коллектора. Пустое значение выключает OTLP: логи остаются в stdout
# контейнера (docker compose logs bot).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
#
# Имя сервиса — становится именем стрима в сервисе Логи. В проде его задаёт файл секретов;
# здесь — дефолт приложения, если переменная не задана.
OTEL_SERVICE_NAME=la-searcher-bot
